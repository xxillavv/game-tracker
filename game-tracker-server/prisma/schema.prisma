generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  userId Int @id @default(autoincrement()) @map("user_id")

  email    String @unique @map("email")
  password String @map("password")
  username String @unique @map("username")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions    Sessions?
  connections Connections[]

  @@map("users")
}

model Sessions {
  sessionId     Int @id @default(autoincrement()) @map("session_id")
  sessionUserId Int @unique @map("user_id")

  token String @unique @map("token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user Users @relation(fields: [sessionUserId], references: [userId], onDelete: Cascade)

  @@map("sessions")
}

model Games {
  gameId Int @id @default(autoincrement()) @map("game_id")

  name String @unique @map("name")

  matches Matches[]

  @@map("games")
}

// Таблиця з статистикою зібраних матчів користувача.
model Matches {
  matchId      Int @id @default(autoincrement()) @map("match_id")
  statsMatchId Int @map("stats_id")
  gameMatchId  Int @map("game_id")

  metadata Json @default("{}") // JSON для уніальних даних про матч для різних ігор (Для доти свій JSON, для кс свій)

  stats GameStats @relation(fields: [statsMatchId], references: [statId], onDelete: Cascade)
  game  Games     @relation(fields: [gameMatchId], references: [gameId], onDelete: Cascade)

  @@map("matches")
}

model News {
  newsId Int @id @default(autoincrement()) @map("news_id")

  title   String @map("title")
  content String @map("content")

  game String @map("game")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("news")
}

enum PlatformNameEmun {
  STEAM
  RIOT
  SUPERCELL
}

// Таблиця з інформацією про підключені платформи користувача.
model Connections {
  connectionId    Int @id @default(autoincrement()) @map("connection_id")
  connectinUserId Int @map("user_id")

  platformName PlatformNameEmun @map("platform_name")
  externalId   String           @map("external_id") // Тег, айдішка юзера на конкретній платформі
  accessToken  String?          @map("access_token")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  users     Users      @relation(fields: [connectinUserId], references: [userId], onDelete: Cascade)
  gameStats GameStats?

  @@map("connections")
}

// Таблиця з ігровою статистикою користувача.
model GameStats {
  statId Int @id @default(autoincrement()) @map("stat_id")

  statsConnectionId Int @unique @map("platform_id")

  metadata Json @default("{}")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  rankHistories RatingHistory[]
  matches       Matches[]

  connections Connections @relation(fields: [statsConnectionId], references: [connectionId], onDelete: Cascade)

  @@map("game_stats")
}

model RatingHistory {
  ratingId     Int @id @default(autoincrement()) @map("rating_id")
  ratingStatId Int @map("stat_id")

  ratingTier Int      @map("rating_tier")
  achievedAt DateTime @default(now()) @map("achieved_at")

  gameStats GameStats @relation(fields: [ratingStatId], references: [statId], onDelete: Cascade)

  @@map("rating_history")
}
